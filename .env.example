# Copy to .env and fill in. .env is gitignored and never committed.

# Funded Robinhood Chain wallet (32-byte hex, with or without 0x). Used by agent.mjs / deploy.mjs /
# compile+deploy / migrate-agentmemory-v2.mjs / redteam.mjs (read via lib/env.mjs).
PRIVATE_KEY=

# Inference key for the agent CLI (agent.mjs chat/compact). Any OpenAI-compatible key; Cerebras by default.
CEREBRAS_API_KEY=

# Optional: override the AgentMemory contract address node/onchain.mjs reads and writes. Normally
# unset. It resolves from out/deployment.json in this repo (the currently deployed contract).
HERO_MEM_ADDR=
